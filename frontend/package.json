{
  "name": "hf-antenna-studio-frontend",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:wasm": "cross-env VITE_ENGINE=wasm vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:wasm": "tsc -b && cross-env VITE_ENGINE=wasm vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:smoke": "node scripts/check-wasm.mjs",
    "test:smoke": "playwright test",
    "test:smoke:isolated": "node scripts/run-playwright-isolated.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0",
    "three": "^0.183.2",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "2.11.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
